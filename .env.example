# Portas publicadas no host (devem coincidir com host/porta na(s) URL(s) abaixo)
POSTGRES_PORT=5432
REDIS_PORT=6379
# docker-compose: API e UI no host (FRONTEND build usa BACKEND_PORT na URL da API no browser)
BACKEND_PORT=3000
FRONTEND_PORT=8888
EXTERNAL_API_URL=https://dummyjson.com

# Credenciais Postgres (usadas pelo container e pela DATABASE_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=app

# URLs usadas pelo backend, Prisma e Redis (porta deve bater com POSTGRES_PORT e REDIS_PORT)
DATABASE_URL=postgresql://postgres:password@localhost:5432/app
REDIS_URL=redis://localhost:6379