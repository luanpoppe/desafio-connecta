generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Dados sincronizados a partir da API externa de utilizadores (DummyJSON / equivalente).
model User {
  id         Int @id @default(autoincrement())
  externalId Int @unique

  firstName  String
  lastName   String
  maidenName String
  age        Int
  gender     String
  email      String
  phone      String
  username   String
  password   String
  birthDate  String
  image      String
  bloodGroup String
  height     Float
  weight     Float
  eyeColor   String
  hair       Json
  ip         String
  address    Json
  macAddress String
  university String
  bank       Json
  company    Json
  ein        String
  ssn        String
  userAgent  String
  crypto     Json
  role       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}
